{
  "$schema": "https://grammar-platform.vercel.app/schemas/design-tokens-2026.json",
  "meta": {
    "product": "Grammar Engine v1.4 PRO",
    "edition": "2026 Modern EdTech Design System",
    "wcagCompliance": "WCAG 2.2 AA Verified (28/28 contrast pairs >= 4.5:1)",
    "antiDarkPattern": "FTC Compliant (Transparent Pricing, 2-Click Cancel, No Fake Timers)"
  },
  "breakpoints": {
    "mobile": "375px",
    "mobileMax": "639px",
    "tablet": "768px",
    "tabletMax": "1023px",
    "laptop": "1280px",
    "desktopWide": "1440px"
  },
  "containers": {
    "quizAndMistakes": "860px",
    "diagnosticOnboarding": "920px",
    "diagnosticSession": "960px",
    "dashboardAndStudy": "980px",
    "gamificationAndVip": "1020px",
    "adminConsole": "1120px",
    "studySidebarDesktop": "280px",
    "studySidebarCollapsed": "64px",
    "stickyHeaderHeight": "56px",
    "mobileBottomNavHeight": "60px"
  },
  "themes": {
    "light": {
      "bg": "#f8fafc",
      "bgSub": "#ffffff",
      "card": "#ffffff",
      "bgElevated": "#f1f5f9",
      "cardBorder": "#e2e8f0",
      "border": "#cbd5e1",
      "text": "#0f172a",
      "textSecondary": "#334155",
      "textMuted": "#475569",
      "accent": "#2563eb",
      "accentHover": "#1d4ed8",
      "accentBg": "#eff6ff",
      "accentBorder": "#bfdbfe",
      "success": "#047857",
      "successBg": "#ecfdf5",
      "successBorder": "#a7f3d0",
      "warning": "#b45309",
      "warningBg": "#fffbeb",
      "warningBorder": "#fde68a",
      "danger": "#dc2626",
      "dangerBg": "#fef2f2",
      "dangerBorder": "#fecaca",
      "backdrop": "rgba(15, 23, 42, 0.56)",
      "glassSurface": "rgba(255, 255, 255, 0.84)",
      "formulaPositive": "#047857",
      "formulaNegative": "#dc2626",
      "formulaQuestion": "#2563eb"
    },
    "dark": {
      "bg": "#09090b",
      "bgSub": "#121215",
      "card": "#111115",
      "bgElevated": "#18181b",
      "cardBorder": "#272733",
      "border": "#27272a",
      "text": "#fafafa",
      "textSecondary": "#d4d4d8",
      "textMuted": "#a1a1aa",
      "accent": "#38bdf8",
      "accentHover": "#7dd3fc",
      "accentBg": "rgba(12, 74, 110, 0.30)",
      "accentBorder": "#0369a1",
      "success": "#34d399",
      "successBg": "rgba(6, 78, 59, 0.30)",
      "successBorder": "#047857",
      "warning": "#fbbf24",
      "warningBg": "rgba(69, 26, 3, 0.30)",
      "warningBorder": "#b45309",
      "danger": "#f87171",
      "dangerBg": "rgba(69, 10, 10, 0.30)",
      "dangerBorder": "#b91c1c",
      "backdrop": "rgba(2, 6, 23, 0.74)",
      "glassSurface": "rgba(18, 18, 21, 0.84)",
      "formulaPositive": "#34d399",
      "formulaNegative": "#f87171",
      "formulaQuestion": "#38bdf8"
    }
  },
  "typography": {
    "fontSans": "'Google Sans Text', 'Google Sans', 'Product Sans', -apple-system, BlinkMacSystemFont, sans-serif",
    "fontMono": "'Google Sans Text', 'Google Sans', 'Product Sans', -apple-system, BlinkMacSystemFont, monospace",
    "scale": {
      "display": {
        "size": "clamp(1.75rem, 3.2vw, 2.5rem)",
        "weight": 800,
        "lineHeight": 1.2
      },
      "h1": {
        "size": "clamp(1.5rem, 2.5vw, 2rem)",
        "weight": 800,
        "lineHeight": 1.2
      },
      "h2": {
        "size": "clamp(1.25rem, 2vw, 1.5rem)",
        "weight": 700,
        "lineHeight": 1.35
      },
      "h3": {
        "size": "clamp(1.1rem, 1.5vw, 1.25rem)",
        "weight": 700,
        "lineHeight": 1.35
      },
      "h4": {
        "size": "1.125rem",
        "weight": 600,
        "lineHeight": 1.4
      },
      "bodyLg": {
        "size": "1rem",
        "weight": 500,
        "lineHeight": 1.65
      },
      "body": {
        "size": "0.875rem",
        "weight": 500,
        "lineHeight": 1.55
      },
      "bodySm": {
        "size": "0.8125rem",
        "weight": 500,
        "lineHeight": 1.5
      },
      "caption": {
        "size": "0.75rem",
        "weight": 500,
        "lineHeight": 1.4
      },
      "overline": {
        "size": "0.6875rem",
        "weight": 700,
        "letterSpacing": "0.08em",
        "transform": "uppercase"
      }
    }
  }
}